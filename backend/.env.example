# Copia este archivo como .env y completa los valores. NUNCA subas .env a git.
DATABASE_URL=postgresql://usuario:clave@ENDPOINT_RDS:5432/videoplatform
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
AWS_REGION=us-east-1
VIDEOS_BUCKET=tuapellido-vp-videos
THUMBS_BUCKET=tuapellido-vp-thumbs
# URL del sitio S3 (sin "/" al final). Varias separadas por coma. "*" solo para pruebas.
CORS_ORIGINS=http://tuapellido-vp-frontend.s3-website-us-east-1.amazonaws.com
